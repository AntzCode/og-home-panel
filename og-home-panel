"""og-home-panel: back, app/overview and quick-action buttons for Linux phones.

A bottom-anchored layer-shell surface that sits above the Phosh home bar.
Key events are injected into the focused app with wtype (virtual keyboard).
Back works like Android: it presses the app's own Back button found through
the accessibility tree (AT-SPI), and sends the app to the background when
there is none to press.

gtk4-layer-shell must be loaded before libwayland, so the script re-executes
itself with the library preloaded.

AT-SPI runs in a helper process (the same script, run with --atspi-helper).
The panel itself runs in a child process (--panel), which the first process
restarts if it crashes.
"""
import os
import re
import signal
import socket
import struct
import subprocess
import sys
import time

HELPER_FLAG = "--atspi-helper"
PANEL_FLAG = "--panel"
RESTART_DELAY_SECONDS = 2
# More restarts than this within RESTART_WINDOW_SECONDS means it would only
# crash again (no compositor, say); give up.
MAX_RESTARTS = 5
RESTART_WINDOW_SECONDS = 60


def supervise():
    """Run the panel in a child process, and restart it after a crash, so
    the phone isn't left without its buttons."""
    child = None

    def stop(signum, _frame):
        if child:
            child.send_signal(signum)
        sys.exit(0)

    signal.signal(signal.SIGTERM, stop)
    starts = []
    while True:
        now = time.monotonic()
        starts = [t for t in starts if now - t < RESTART_WINDOW_SECONDS]
        if len(starts) > MAX_RESTARTS:
            print("panel: keeps crashing, giving up", flush=True)
            sys.exit(1)
        starts.append(now)
        child = subprocess.Popen([sys.executable, *sys.argv, PANEL_FLAG])
        try:
            code = child.wait()
        except KeyboardInterrupt:
            sys.exit(0)
        # 0: a clean exit, or a second launch that handed over to the
        # running panel.
        if code in (0, -signal.SIGTERM, -signal.SIGINT):
            sys.exit(0)
        print(f"panel: exited with {code}, restarting", flush=True)
        time.sleep(RESTART_DELAY_SECONDS)


if HELPER_FLAG not in sys.argv and PANEL_FLAG not in sys.argv:
    supervise()

LAYER_SHELL_LIB = "/usr/lib/libgtk4-layer-shell.so.0"
if (HELPER_FLAG not in sys.argv
        and LAYER_SHELL_LIB not in os.environ.get("LD_PRELOAD", "")):
    os.environ["LD_PRELOAD"] = " ".join(
        filter(None, [LAYER_SHELL_LIB, os.environ.get("LD_PRELOAD")]))
    os.execv(sys.executable, [sys.executable, *sys.argv])
# Loaded now; keep it out of the processes this one starts. Firefox, opened
# from a link in About, aborted with GTK 4 loaded next to its GTK 3.
_preload = [lib for lib in os.environ.get("LD_PRELOAD", "").split()
            if lib != LAYER_SHELL_LIB]
if _preload:
    os.environ["LD_PRELOAD"] = " ".join(_preload)
else:
    os.environ.pop("LD_PRELOAD", None)

