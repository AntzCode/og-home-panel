"""og-home-panel: back, app/overview and quick-action buttons for Linux phones.

A bottom-anchored layer-shell surface that sits above the Phosh home bar.
Key events are injected into the focused app with wtype (virtual keyboard).
Back works like Android: it presses the app's own Back button found through
the accessibility tree (AT-SPI), and sends the app to the background when
there is none to press.

gtk4-layer-shell must be loaded before libwayland, so the script re-executes
itself with the library preloaded.

AT-SPI runs in a helper process (the same script, run with --atspi-helper).
"""
import os
import re
import socket
import struct
import subprocess
import sys
import time

HELPER_FLAG = "--atspi-helper"
LAYER_SHELL_LIB = "/usr/lib/libgtk4-layer-shell.so.0"
if (HELPER_FLAG not in sys.argv
        and LAYER_SHELL_LIB not in os.environ.get("LD_PRELOAD", "")):
    os.environ["LD_PRELOAD"] = " ".join(
        filter(None, [LAYER_SHELL_LIB, os.environ.get("LD_PRELOAD")]))
    os.execv(sys.executable, [sys.executable, *sys.argv])

import gi

gi.require_version("Atspi", "2.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Gtk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
gi.require_version("Lfb", "0.0")
