def haptic(*_args):
    Lfb.Event.new("button-pressed").trigger_feedback_async(None, None)


def button_row(css_class, buttons, spread=False, **props):
    """A row of buttons, packed from the left or with the free width spread
    between them."""
    row = Gtk.Box(css_classes=[css_class], **props)
    for i, button in enumerate(buttons):
        if i and spread:
            row.append(Gtk.Box(hexpand=True))
        row.append(button)
    return row


def nav_button(icon, on_tap, on_long_press=None, toggle=False):
    button = (Gtk.ToggleButton if toggle else Gtk.Button)(icon_name=icon)
    button.add_css_class("nav")
    # Feedback on touch down, so a tap is felt before its action completes.
    touch = Gtk.GestureClick()
    touch.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
    touch.connect("pressed", haptic)
    button.add_controller(touch)
    button.connect("toggled" if toggle else "clicked", on_tap)
    if on_long_press:
        press = Gtk.GestureLongPress()
        press.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)

        def pressed(gesture, _x, _y):
            # Claiming the sequence cancels the button's own click.
            gesture.set_state(Gtk.EventSequenceState.CLAIMED)
            on_long_press()

        press.connect("pressed", pressed)
        button.add_controller(press)
    return button


LOGIN1 = "org.freedesktop.login1"


def login1_get(bus, path, interface, prop):
    reply = bus.call_sync(
        LOGIN1, path, "org.freedesktop.DBus.Properties", "Get",
        GLib.Variant("(ss)", (interface, prop)), GLib.VariantType("(v)"),
        Gio.DBusCallFlags.NONE, -1, None)
    return reply.unpack()[0]


def watch_locked(callback):
    """Call callback(locked) now and whenever the session is (un)locked.

    Phosh's org.gnome.ScreenSaver "active" follows screen blanking, not the
    lock screen, so use logind's LockedHint, which Phosh sets on lock.
    Returns the system bus connection; keep it, or the subscription dies
    with it (GIO holds the shared connection only weakly).
    """
    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM)
    _id, session = login1_get(bus, "/org/freedesktop/login1/user/self",
                              "org.freedesktop.login1.User", "Display")

    def changed(*args):
        props = args[5].unpack()[1]
        if "LockedHint" in props:
            callback(props["LockedHint"])

    bus.signal_subscribe(
        LOGIN1, "org.freedesktop.DBus.Properties", "PropertiesChanged",
        session, "org.freedesktop.login1.Session", Gio.DBusSignalFlags.NONE,
        changed)
    callback(login1_get(bus, session, "org.freedesktop.login1.Session",
                        "LockedHint"))
    return bus


class Toplevel:
    """An app window, as wlr-foreign-toplevel reports it."""

    def __init__(self):
        self.title = self.app_id = ""
        self.states = set()
        self.pending = None  # States waiting for the next done event
        self.used = 0  # When it was last activated, for most-recent order


class ToplevelWatcher:
    """Track the open app windows, and report whether the focused one is
    fullscreen.

    A minimal Wayland client for wlr-foreign-toplevel-management, which phoc
    implements. GTK doesn't expose the protocol and pywayland lacks the wlr
    protocols, so this speaks the few messages it needs over its own socket.
    """
    MANAGER = "zwlr_foreign_toplevel_manager_v1"
    ACTIVATED, FULLSCREEN = 2, 3  # zwlr_foreign_toplevel_handle_v1.state
    HANDLE_ACTIVATE, HANDLE_DESTROY = 4, 7

    def __init__(self, report, on_windows):
        self.report = report
        self.on_windows = on_windows
        self.fullscreen = False
        self.objects = {1: self.on_display}
        self.next_id = 2
        self.handles = {}  # id -> Toplevel
        self.seat = None
        self.activations = 0
        self.buffer = b""
        display = os.environ.get("WAYLAND_DISPLAY", "wayland-0")
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(os.path.join(
            os.environ.get("XDG_RUNTIME_DIR", ""), display))
        registry = self.new_object(self.on_registry)
        self.send(1, 1, struct.pack("=I", registry))  # wl_display.get_registry
        GLib.io_add_watch(self.sock.fileno(), GLib.PRIORITY_DEFAULT,
                          GLib.IOCondition.IN | GLib.IOCondition.HUP,
                          self.readable)

    def new_object(self, handler):
        object_id = self.next_id
        self.next_id += 1
        self.objects[object_id] = handler
        return object_id

    def send(self, object_id, opcode, body):
        self.sock.sendall(struct.pack(
            "=II", object_id, (8 + len(body)) << 16 | opcode) + body)

    def readable(self, *_args):
        data = self.sock.recv(4096)
        if not data:
            print("toplevels: compositor connection closed", flush=True)
            self.handles.clear()
            self.update()
            return GLib.SOURCE_REMOVE
        self.buffer += data
        while len(self.buffer) >= 8:
            object_id, word = struct.unpack_from("=II", self.buffer)
            size = word >> 16
            if len(self.buffer) < size:
                break
            body, self.buffer = self.buffer[8:size], self.buffer[size:]
            handler = self.objects.get(object_id)
            if handler:
                handler(object_id, word & 0xFFFF, body)
        return GLib.SOURCE_CONTINUE

    @staticmethod
    def string(body, offset):
        """Return (text, offset after it) for a wire string at offset."""
        length, = struct.unpack_from("=I", body, offset)
        text = body[offset + 4:offset + 4 + length - 1].decode(
            errors="replace")
        return text, offset + 4 + (length + 3) // 4 * 4

    def on_display(self, _id, opcode, body):
        if opcode == 0:  # error
            print("toplevels: wayland error",
                  self.string(body, 8)[0], flush=True)

    def bind(self, registry, name, interface, version, handler):
        object_id = self.new_object(handler)
        iface = interface.encode() + b"\0"
        iface += b"\0" * (-len(iface) % 4)
        self.send(registry, 0, struct.pack("=II", name, len(
            interface) + 1) + iface + struct.pack(
            "=II", version, object_id))  # wl_registry.bind
        return object_id

    def on_registry(self, registry, opcode, body):
        if opcode != 0:  # only global
            return
        name, = struct.unpack_from("=I", body)
        interface, offset = self.string(body, 4)
        version, = struct.unpack_from("=I", body, offset)
        if interface == self.MANAGER:
            self.bind(registry, name, interface, min(version, 3),
                      self.on_manager)
        elif interface == "wl_seat" and self.seat is None:
            # Activating a window needs a seat; its events aren't needed.
            self.seat = self.bind(registry, name, interface, 1,
                                  lambda *_args: None)

    def on_manager(self, _id, opcode, body):
        if opcode == 0:  # toplevel
            handle, = struct.unpack_from("=I", body)
            self.objects[handle] = self.on_handle
            self.handles[handle] = Toplevel()

    def on_handle(self, handle, opcode, body):
        window = self.handles[handle]
        if opcode == 0:  # title
            window.title = self.string(body, 0)[0]
        elif opcode == 1:  # app_id
            window.app_id = self.string(body, 0)[0]
        elif opcode == 4:  # state
            length, = struct.unpack_from("=I", body)
            window.pending = set(
                struct.unpack_from(f"={length // 4}I", body, 4))
        elif opcode == 5:  # done
            # The compositor sends a window's changes (title, states...)
            # first, then "done" to say they're complete; only now do the
            # pending states take effect.
            if window.pending is not None:
                # The window just became the focused one (it wasn't before).
                # Stamp it from an ever-increasing counter, so sorting by
                # stamp gives most-recently-used order for the switcher.
                # Checking the old states means a state change while it
                # stays focused (e.g. going fullscreen) doesn't count.
                if (self.ACTIVATED in window.pending
                        and self.ACTIVATED not in window.states):
                    self.activations += 1
                    window.used = self.activations
                window.states, window.pending = window.pending, None
            self.update()
        elif opcode == 6:  # closed
            del self.handles[handle], self.objects[handle]
            self.send(handle, self.HANDLE_DESTROY, b"")
            self.update()

    def windows(self):
        """(handle, Toplevel) pairs, most recently used first."""
        return sorted(self.handles.items(), key=lambda item: -item[1].used)

    def focused(self):
        """The focused app window, or None."""
        return next((window for window in self.handles.values()
                     if self.ACTIVATED in window.states), None)

    def activate(self, handle):
        if handle in self.handles and self.seat is not None:
            self.send(handle, self.HANDLE_ACTIVATE,
                      struct.pack("=I", self.seat))

    def update(self):
        self.on_windows()
        fullscreen = any({self.ACTIVATED, self.FULLSCREEN} <= window.states
                         for window in self.handles.values())
        if fullscreen != self.fullscreen:
            self.fullscreen = fullscreen
            self.report(fullscreen)


class RotationWatcher:
    """Offer to rotate the screen when the phone is turned while rotation
    is locked, like Android's rotate button.

    Calls offer(transform) when the phone's orientation stops matching the
    screen's, and offer(None) when it matches again.
    """
    SENSOR = ("net.hadess.SensorProxy", "/net/hadess/SensorProxy",
              "net.hadess.SensorProxy")
    DISPLAY = ("org.gnome.Mutter.DisplayConfig",
               "/org/gnome/Mutter/DisplayConfig",
               "org.gnome.Mutter.DisplayConfig")
    LOCK_SCHEMA = "org.gnome.settings-daemon.peripherals.touchscreen"

    def __init__(self, offer):
        self.offer = offer
        self.claimed = False
        self.current = 0  # The display's transform when last checked
        self.system_bus = Gio.bus_get_sync(Gio.BusType.SYSTEM)
        self.session_bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        source = Gio.SettingsSchemaSource.get_default()
        self.settings = (Gio.Settings.new(self.LOCK_SCHEMA) if source
                         and source.lookup(self.LOCK_SCHEMA, True) else None)
        self.system_bus.signal_subscribe(
            self.SENSOR[0], "org.freedesktop.DBus.Properties",
            "PropertiesChanged", self.SENSOR[1], self.SENSOR[2],
            Gio.DBusSignalFlags.NONE, self.on_sensor)

    def set_active(self, active):
        """Claim the accelerometer only while needed; it costs power."""
        if active == self.claimed:
            return
        try:
            self.system_bus.call_sync(
                *self.SENSOR, "ClaimAccelerometer" if active
                else "ReleaseAccelerometer", None, None,
                Gio.DBusCallFlags.NONE, -1, None)
            self.claimed = active
        except GLib.Error as error:
            print("rotation:", error.message, flush=True)

    def on_sensor(self, *args):
        orientation = args[5].unpack()[1].get("AccelerometerOrientation")
        transform = ORIENTATION_TRANSFORMS.get(orientation)
        if transform is None:  # Unchanged, or "undefined" (lying flat)
            return
        locked = self.settings and self.settings.get_boolean(
            "orientation-lock")
        try:
            self.current = self.display_state()[2][0][3]
        except (GLib.Error, IndexError):
            return
        self.offer(transform if locked and transform != self.current
                   else None)

    def display_state(self):
        return self.session_bus.call_sync(
            *self.DISPLAY, "GetCurrentState", None, None,
            Gio.DBusCallFlags.NONE, -1, None).unpack()

    def rotate(self, transform):
        """Apply the current monitor setup with a new transform."""
        serial, monitors, logical, _props = self.display_state()
        modes = {monitor[0][0]: next(mode[0] for mode in monitor[1]
                                     if mode[6].get("is-current"))
                 for monitor in monitors}
        config = [(x, y, scale, transform, primary,
                   [(c[0], modes[c[0]], {}) for c in connectors])
                  for x, y, scale, _old, primary, connectors, _p in logical]
        # Method 2 (persistent): Phosh ignores 1 (temporary).
        self.session_bus.call_sync(
            *self.DISPLAY, "ApplyMonitorsConfig",
            GLib.Variant("(uua(iiduba(ssa{sv}))a{sv})",
                         (serial, 2, config, {})),
            None, Gio.DBusCallFlags.NONE, -1, None)


def init_layer_surface(window):
    """Make window a layer surface along the bottom edge of the screen."""
    window.add_css_class("og-home-panel")
    LayerShell.init_for_window(window)
    LayerShell.set_namespace(window, "og-home-panel")
    # Overlay, so Phosh's overview and the OSK stack above the panel
    # instead of covering it.
    LayerShell.set_layer(window, LayerShell.Layer.OVERLAY)
    for edge in (LayerShell.Edge.BOTTOM, LayerShell.Edge.LEFT,
                 LayerShell.Edge.RIGHT):
        LayerShell.set_anchor(window, edge, True)
    # Never take keyboard focus, so injected keys reach the app.
    LayerShell.set_keyboard_mode(window, LayerShell.KeyboardMode.NONE)


def app_info(app_id):
    """The installed app a window's app ID belongs to, or None."""
    try:
        return Gio.DesktopAppInfo.new(app_id + ".desktop")
    except TypeError:  # Not found
        pass
    for info in Gio.AppInfo.get_all():
        if app_id in (info.get_startup_wm_class(),
                      info.get_id().removesuffix(".desktop").lower()):
            return info
    return None


class SheetMenu(Gtk.Window):
    """A list of rows along the bottom of the screen, above the bar.

    The rest of the screen is dimmed, and tapping it closes the menu.
    """

    def __init__(self, app, on_done):
        super().__init__(application=app)
        init_layer_surface(self)
        self.add_css_class("sheet")
        LayerShell.set_anchor(self, LayerShell.Edge.TOP, True)
        LayerShell.set_exclusive_zone(self, -1)
        self.on_done = on_done
        self.list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL,
                            css_classes=["rows"])
        outside = Gtk.Box(vexpand=True)
        tap = Gtk.GestureClick()
        tap.connect("released", lambda *_args: self.on_done())
        outside.add_controller(tap)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.append(outside)
        box.append(Gtk.ScrolledWindow(
            child=self.list, hscrollbar_policy=Gtk.PolicyType.NEVER,
            propagate_natural_height=True))
        self.set_child(box)

    def clear(self):
        while child := self.list.get_first_child():
            self.list.remove(child)

    def add_row(self, icon, label, on_pick, current=False):
        """Add a row; icon is a Gio.Icon or an icon name. Picking it closes
        the menu, then calls on_pick()."""
        image = Gtk.Image(pixel_size=32)
        if isinstance(icon, str):
            image.set_from_icon_name(icon)
        else:
            image.set_from_gicon(icon)
        row = Gtk.Box(spacing=12)
        row.append(image)
        row.append(Gtk.Label(label=label, xalign=0, hexpand=True,
                             ellipsize=Pango.EllipsizeMode.END))
        button = Gtk.Button(child=row, css_classes=["row"])
        if current:
            button.add_css_class("current")
        touch = Gtk.GestureClick()
        touch.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        touch.connect("pressed", haptic)
        button.add_controller(touch)
        button.connect("clicked", lambda _b: (self.on_done(), on_pick()))
        self.list.append(button)


class AppSwitcher(SheetMenu):
    """The running apps, like Alt+Tab: tap one to switch to it. The most
    recently used app is nearest the bar."""

    def __init__(self, app, toplevels, on_done):
        super().__init__(app, on_done)
        self.toplevels = toplevels

    def refresh(self):
        """Rebuild the list; returns False when no app is running."""
        self.clear()
        windows = self.toplevels.windows()
        for handle, window in reversed(windows):
            info = app_info(window.app_id)
            self.add_row(
                info and info.get_icon() or "application-x-executable",
                window.title or (info and info.get_display_name())
                or window.app_id,
                lambda h=handle: self.toplevels.activate(h),
                current=ToplevelWatcher.ACTIVATED in window.states)
        return bool(windows)


def phoc_app_settings(app_id):
    """Phoc's per-app settings (sm.puri.phoc.application) for an app ID."""
    # Phoc's path for an app: its ID with every character other than a
    # letter, digit or "-" made a "-", in lower case.
    name = re.sub(r"[^0-9A-Za-z-]", "-", app_id).lower()
    return Gio.Settings.new_with_path(
        "sm.puri.phoc.application", f"/sm/puri/phoc/application/{name}/")


class PanelMenu(SheetMenu):
    """The panel's own menu (⋯ long press)."""

    def __init__(self, app, toplevels, on_done, on_about):
        super().__init__(app, on_done)
        self.toplevels = toplevels
        self.on_about = on_about

    def refresh(self):
        self.clear()
        window = self.toplevels.focused()
        if window and window.app_id:
            info = app_info(window.app_id)
            name = info.get_display_name() if info else window.app_id
            settings = phoc_app_settings(window.app_id)
            if settings.get_boolean("scale-to-fit"):
                self.add_row("tv-symbolic",
                             f"Stop fitting {name} to the screen",
                             lambda: self.set_fit(settings, False))
            else:
                self.add_row("phone-apple-iphone-symbolic",
                             f"Fit {name} to the screen",
                             lambda: self.set_fit(settings, True))
        self.add_row("help-about-symbolic", f"About {APP_NAME}",
                     self.on_about)
        return True

    @staticmethod
    def set_fit(settings, fit):
        """Turn phoc's scale-to-fit on for the app (it shrinks a window
        that's bigger than the screen), or remove the setting again."""
        if fit:
            settings.set_boolean("scale-to-fit", True)
        else:
            settings.reset("scale-to-fit")
        Gio.Settings.sync()


class AboutScreen(Adw.Window):
    """A full-screen surface that hosts the About dialog, which libadwaita
    shows inside a window (as a bottom sheet on a phone)."""

    def __init__(self, app, on_closed):
        super().__init__(application=app)
        init_layer_surface(self)
        LayerShell.set_anchor(self, LayerShell.Edge.TOP, True)
        LayerShell.set_exclusive_zone(self, -1)
        self.set_content(Gtk.Box())
        self.on_closed = on_closed
        self.dialog = None

    def present_dialog(self):
        self.dialog = Adw.AboutDialog(
            application_name=APP_NAME,
            application_icon="go-home-symbolic",
            developer_name="AntzCode",
            comments="Android-style Back, app switcher and quick actions "
                     "for Linux phones.",
            website=REPO_URL,
            issue_url=REPO_URL + "/issues",
            copyright="© 2026 AntzCode",
            # Custom text instead of license_type, whose wording can't be
            # changed. It's Pango markup; the link opens through on_link.
            license="This application is free to use, modify and share, "
                    "but it comes with absolutely no warranty. See the "
                    "<a href=\"https://www.gnu.org/licenses/gpl-3.0.html\">"
                    "GNU General Public License, version 3 or later</a> "
                    "for details.")
        self.dialog.connect("closed", self.on_dialog_closed)
        self.dialog.connect("activate-link", self.on_link)
        self.dialog.present(self)

    def on_link(self, _dialog, uri):
        # GTK's own handler exports this window's handle for the portal,
        # and phoc drops the connection with a protocol error, since a layer
        # surface isn't a toplevel. Open it without a parent window instead,
        # and close the dialog so it doesn't cover the browser.
        print("open link:", uri, flush=True)
        try:
            Gio.AppInfo.launch_default_for_uri(uri, None)
        except GLib.Error as error:
            print("open link failed:", error.message, flush=True)
        self.close_dialog()
        return True

    def on_dialog_closed(self, _dialog):
        self.dialog = None
        self.on_closed()

    def close_dialog(self):
        if self.dialog:
            self.dialog.force_close()


class HomePanel(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app)
        init_layer_surface(self)

        self.more = nav_button("view-more-symbolic", self.on_more,
                               self.on_more_held, toggle=True)
        # The rotate offer briefly takes the ⋯ button's place.
        self.rotate = nav_button("rotation-allowed-symbolic", self.on_rotate)
        self.more_slot = Gtk.Stack(
            transition_type=Gtk.StackTransitionType.CROSSFADE)
        self.more_slot.add_child(self.more)
        self.more_slot.add_child(self.rotate)
        self.offered = None
        self.offer_timeout = 0
        self.osk_hidden_until = 0
        Gio.bus_get_sync(Gio.BusType.SESSION).signal_subscribe(
            "sm.puri.OSK0", "org.freedesktop.DBus.Properties",
            "PropertiesChanged", "/sm/puri/OSK0", "sm.puri.OSK0",
            Gio.DBusSignalFlags.NONE, self.on_osk_changed)
        self.bar = button_row("bar", [
            nav_button("go-previous-symbolic", self.on_back,
                       lambda: send_keys("escape")),
            nav_button("view-app-grid-symbolic", self.on_apps,
                       self.on_apps_held),
            nav_button("input-keyboard-symbolic",
                       lambda _b: set_osk_visible(not osk_visible())),
            self.more_slot,
        ], spread=True, height_request=BAR_HEIGHT)
        self.set_child(self.bar)
        self.connect("map", self.on_map)

        # The quick-actions row is a surface of its own above the bar, so
        # the bar's surface never changes size. Resizing a layer-shell window
        # left the bar off the bottom edge or short of the full width.
        self.actions = Gtk.Window(application=app)
        init_layer_surface(self.actions)
        # Overlap the app instead of resizing it.
        LayerShell.set_exclusive_zone(self.actions, -1)
        # Packed from the left, so each action stays in the same place
        # whatever the screen width, for muscle memory.
        self.actions.set_child(button_row("actions", [
            nav_button(icon, lambda _b, a=action: send_keys(a),
                       held and (lambda h=held: send_keys(h)))
            for icon, action, held in QUICK_ACTIONS]))

        # In fullscreen the bar is hidden, so the rotate offer floats on its
        # own where ⋯ would be, without resizing the app.
        self.rotate_float = Gtk.Window(application=app)
        init_layer_surface(self.rotate_float)
        LayerShell.set_anchor(self.rotate_float, LayerShell.Edge.LEFT, False)
        LayerShell.set_exclusive_zone(self.rotate_float, -1)
        self.floating = nav_button("rotation-allowed-symbolic",
                                   self.on_rotate)
        self.floating.add_css_class("floating")
        self.rotate_float.set_child(self.floating)

        # The open app windows, for the switcher and fullscreen hiding.
        self.toplevels = ToplevelWatcher(
            lambda fullscreen: self.hide_for("fullscreen", fullscreen),
            self.on_windows)
        # The menu (switcher or panel menu) that's open, if any.
        self.menu = None
        self.switcher = AppSwitcher(app, self.toplevels,
                                    lambda: self.show_menu(None))
        self.panel_menu = PanelMenu(app, self.toplevels,
                                    lambda: self.show_menu(None),
                                    self.show_about)
        self.about_open = False
        self.about = AboutScreen(app, lambda: self.show_about(False))

        self.rotation = RotationWatcher(self.offer_rotation)
        # The lock screen is also on the overlay layer; keep off it.
        self.hidden_by = set()
        self.system_bus = watch_locked(
            lambda locked: self.hide_for("locked", locked))
        # Phosh's quick-settings drawer is on the top layer, below the panel,
        # and its bottom row would be covered.
        self.atspi = AtspiHelper(
            lambda drawer_open: self.hide_for("drawer open", drawer_open))

    def on_map(self, _window):
        # Reserve only the bar, and put the actions row right above it.
        # Measure it, since the theme's button padding makes it taller than
        # BAR_HEIGHT.
        height = self.bar.measure(Gtk.Orientation.VERTICAL, -1)[1]
        LayerShell.set_exclusive_zone(self, height)
        LayerShell.set_margin(self.actions, LayerShell.Edge.BOTTOM, height)
        # The About screen too: the bar would cover the bottom of its
        # dialog, as it sits above it in the overlay layer.
        for surface in (self.switcher, self.panel_menu, self.about):
            LayerShell.set_margin(surface, LayerShell.Edge.BOTTOM, height)
        print("exclusive zone:", height, flush=True)

    def hide_for(self, reason, hidden):
        """Hide the panel while any reason (lock, drawer, fullscreen) applies."""
        print(f"{reason}: {hidden}", flush=True)
        if hidden:
            self.hidden_by.add(reason)
        else:
            self.hidden_by.discard(reason)
        if reason == "locked":
            self.rotation.set_active(not hidden)
        self.update_visibility()

    def update_visibility(self):
        self.set_visible(not self.hidden_by)
        self.actions.set_visible(not self.hidden_by and self.more.get_active())
        for menu in (self.switcher, self.panel_menu):
            menu.set_visible(not self.hidden_by and self.menu is menu)
        self.about.set_visible(not self.hidden_by and self.about_open)
        self.rotate_float.set_visible(self.offered is not None
                                      and self.hidden_by == {"fullscreen"})

    def on_back(self, _button):
        if self.menu:
            self.show_menu(None)
            return
        self.atspi.send(f"back {time.monotonic()}")

    def on_apps(self, _button):
        if self.menu:
            self.show_menu(None)
        else:
            self.open_overview()

    def on_apps_held(self):
        if self.menu is self.switcher:
            self.show_menu(None)
        elif self.toplevels.windows():
            self.show_menu(self.switcher)
        else:  # Nothing to switch to; open the overview to start an app.
            self.open_overview()

    def open_overview(self):
        # Phosh focuses the overview's search field, which brings up the
        # keyboard and covers the app grid; keep it closed.
        self.keep_osk_closed()
        send_keys("app-view")

    def on_more(self, _button):
        if self.more.get_active():
            self.menu = None
        self.update_visibility()

    def on_more_held(self):
        """Toggle the panel menu. Opening it closes the quick-actions row."""
        if self.menu is self.panel_menu:
            self.show_menu(None)
        else:
            self.show_menu(self.panel_menu)

    def show_menu(self, menu):
        """Open a menu (closing any other), or None to close it."""
        if menu:
            menu.refresh()
            # One overlay at a time: the quick-actions row closes.
            self.more.set_active(False)
        self.menu = menu
        self.update_visibility()

    def show_about(self, show=True):
        self.about_open = show
        self.update_visibility()
        if show:
            self.about.present_dialog()
        else:
            self.about.close_dialog()

    def on_windows(self):
        if self.menu is self.switcher and not self.switcher.refresh():
            self.show_menu(None)

    def offer_rotation(self, transform):
        """Show the rotate button for a few seconds, or None to take it
        away."""
        if self.offer_timeout:
            GLib.source_remove(self.offer_timeout)
            self.offer_timeout = 0
        self.offered = transform
        self.more_slot.set_visible_child(
            self.more if transform is None else self.rotate)
        if transform is not None:
            self.place_floating((transform - self.rotation.current) % 4)
            self.offer_timeout = GLib.timeout_add_seconds(
                ROTATE_OFFER_SECONDS, self.end_offer)
        self.update_visibility()

    def place_floating(self, turns):
        """Put the floating rotate button in the bottom-right corner of the
        rotated view; turns is how far the phone is turned, in clockwise
        quarter turns."""
        edges = [LayerShell.Edge.TOP, LayerShell.Edge.RIGHT,
                 LayerShell.Edge.BOTTOM, LayerShell.Edge.LEFT]
        corner = {edges[(2 - turns) % 4], edges[(1 - turns) % 4]}
        for edge in edges:
            LayerShell.set_anchor(self.rotate_float, edge, edge in corner)
        # Turn the icon upright too.
        for turn in range(1, 4):
            self.floating.remove_css_class(f"turn-{turn}")
        if turns:
            self.floating.add_css_class(f"turn-{turns}")

    def end_offer(self):
        self.offer_timeout = 0
        self.offer_rotation(None)
        return GLib.SOURCE_REMOVE

    def on_rotate(self, _button):
        transform = self.offered
        self.offer_rotation(None)
        if transform is None:
            return
        print("rotate to transform", transform, flush=True)
        try:
            self.keep_osk_closed()
            self.rotation.rotate(transform)
        except GLib.Error as error:
            print("rotate failed:", error.message, flush=True)

    def keep_osk_closed(self):
        """If the keyboard is closed, close it again should it show itself
        within OSK_RESHOW_SECONDS."""
        if not osk_visible():
            self.osk_hidden_until = time.monotonic() + OSK_RESHOW_SECONDS

    def on_osk_changed(self, *args):
        # Stevia rebuilds itself for the new screen size and comes back
        # visible after a rotation; the overview's search field opens it.
        if (args[5].unpack()[1].get("Visible")
                and time.monotonic() < self.osk_hidden_until):
            self.osk_hidden_until = 0
            set_osk_visible(False)


def main():
    if HELPER_FLAG in sys.argv:
        helper_main()
        return
    # Adw.Application loads libadwaita's styles, for the About dialog.
    app = Adw.Application(application_id=APP_ID)
    Lfb.init(app.get_application_id())

    def activate(app):
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        # A second launch only re-activates the running instance.
        if not app.get_active_window():
            HomePanel(app)

    app.connect("activate", activate)
    app.run()


if __name__ == "__main__":
    main()
